# ---- 项目标识 ----
COMPOSE_PROJECT_NAME=entresolv

# ---- 端口（题目分配，不可改）----
FRONTEND_PORT=18222
BACKEND_PORT=19222
DB_PORT=17722

# ---- 数据库 ----
DB_NAME=entresolv
DB_USER=entresolv
DB_PASSWORD=entresolv_pw_2026

# ---- 安全 ----
JWT_SECRET=entresolv-jwt-secret-change-me-2026

# ---- 运行时 ----
REDIS_URL=redis://redis:6379/0
EVIDENCE_DIR=/data/evidence
SEED_DEMO=true
# 初始阈值（MergeRule 可在规则页调整，运行会快照参数）
AUTO_THRESHOLD=0.92
REVIEW_THRESHOLD=0.75
